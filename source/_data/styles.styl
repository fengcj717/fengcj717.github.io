:root
  --body-bg-color #f5f6fa
  --content-bg-color #ffffff
  --card-bg-color #ffffff
  --text-color #273142
  --blockquote-color #667085
  --link-color #345cf6
  --link-hover-color #2447cf
  --menu-item-bg-color #edf1ff
  --theme-color #345cf6
  --btn-default-bg #ffffff
  --btn-default-color #273142
  --btn-default-border-color #e3e7ef
  --btn-default-hover-bg #345cf6
  --btn-default-hover-color #ffffff
  --btn-default-hover-border-color #345cf6
  --highlight-background #f5f7fb
  --highlight-foreground #344054
  --highlight-gutter-background #eef1f6
  --highlight-gutter-foreground #667085
  --home-border #e6e9f0
  --home-muted #697386
  --home-shadow 0 10px 32px rgba(38, 49, 80, 0.06)
  color-scheme light

html
  scroll-behavior smooth

body
  background: #f5f6fa
  color: var(--text-color)
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif

.headband
  display: none

header.header
  background: rgba(255, 255, 255, 0.94)
  border-bottom: 1px solid rgba(224, 228, 237, 0.86)
  box-shadow: 0 4px 18px rgba(36, 46, 74, 0.035)
  margin: 0
  position: relative
  z-index: 20

.header-inner
  max-width: 1240px
  padding: 0 16px
  width: calc(100% - 24px)

.site-brand-container
  align-items: center
  background: transparent
  border: 0
  box-shadow: none
  display: flex
  gap: 12px
  min-height: 70px
  padding: 10px 0

.site-meta
  padding: 0

.site-title
  color: #171d2b
  font-size: 1.18rem
  font-weight: 760
  letter-spacing: -0.02em

.site-subtitle
  color: #7b8494
  font-size: 0.74rem
  margin-top: 3px

.site-nav
  background: transparent
  border: 0
  backdrop-filter: none

.menu .menu-item a
  border-radius: 10px
  color: #353d4d
  font-size: 0.92rem
  font-weight: 600
  padding: 8px 13px

.menu .menu-item a:hover,
.menu .menu-item a.menu-item-active
  background: #edf1ff
  color: #345cf6

.site-nav-toggle .toggle,
.site-nav-right .toggle
  color: #222a38

.site-nav-toggle .toggle .toggle-line,
.site-nav-right .toggle .toggle-line
  background: #222a38

.main
  align-items: flex-start
  gap: 18px
  margin: 0 auto
  max-width: 1240px
  padding: 18px 0 0
  width: calc(100% - 24px)

.main-inner
  background: #ffffff
  border: 1px solid var(--home-border)
  border-radius: 18px
  box-shadow: var(--home-shadow)
  padding: 34px

.footer-inner
  color: #7e8797
  padding-top: 20px

.post-block:first-of-type
  padding-top: 40px

.posts-expand .post-header
  text-align: left

.posts-expand .post-title
  font-size: 1.6em
  font-weight: 650

.posts-expand .post-title-link
  color: #1f2735

.posts-expand .post-body
  color: #4f596b

@media (max-width: 767px)
  .header-inner,
  .main
    width: calc(100% - 16px)

  .site-brand-container
    min-height: 58px

  .main-inner
    padding: 22px
